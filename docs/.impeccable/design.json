    {
      "name": "Primary action",
      "kind": "button",
      "description": "Existing Get started navigation anchor.",
      "html": "<a class=\"ds-primary\" href=\"/pineapple/getting-started/\">Get started</a>",
      "css": ".ds-primary{display:inline-block;padding:.65rem 1.1rem;border-radius:var(--radius);background:var(--accent);color:var(--accent-ink);text-decoration:none;font-weight:600;font-family:ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;line-height:1.6;}.ds-primary:hover{background:var(--accent-hover)}.ds-primary:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary action",
      "kind": "button",
      "description": "Existing View on GitHub navigation anchor.",
      "html": "<a class=\"ds-secondary\" href=\"https://github.com/MILL5/pineapple\">View on GitHub</a>",
      "css": ".ds-secondary{display:inline-block;padding:.65rem 1.1rem;border-radius:var(--radius);background:var(--accent);color:var(--accent-ink);text-decoration:none;font-weight:600;font-family:ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;line-height:1.6;background:transparent;color:var(--text);border:1px solid var(--border)}.ds-secondary:hover{background:var(--accent-soft);border-color:var(--accent)}.ds-secondary:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Guide card",
      "kind": "card",
      "description": "Whole-card guide link.",
      "html": "<a class=\"ds-card\" href=\"/pineapple/guides/shortguid/\"><h3>ShortGuid</h3><p>A Guid as 22 URL-safe characters, with implicit conversions to Guid and string.</p></a>",
      "css": ".ds-card{display:block;background:var(--surface);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:1.1rem 1.2rem;text-decoration:none;transition:border-color .15s ease-out;font-family:ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;line-height:1.6;}.ds-card h3{margin:0 0 .35rem;font-size:1.05rem;line-height:1.25;color:var(--accent)}.ds-card p{margin:0;color:var(--muted);font-size:.95rem}.ds-card:hover,.ds-card:focus-within{border-color:var(--accent)}.ds-card:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}",
      "refersTo": "card"
    },
    {
      "name": "Primary navigation",
      "kind": "nav",
      "description": "Header navigation using real route labels and current-page state.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Primary\"><a href=\"/pineapple/getting-started/\">Get started</a><a href=\"/pineapple/guides/\" aria-current=\"page\">Guides</a><a href=\"https://github.com/MILL5/pineapple\">GitHub</a></nav>",
      "css": ".ds-nav{display:flex;gap:1.25rem;flex-wrap:wrap;font-family:ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif;line-height:1.6;}.ds-nav a{color:var(--muted);text-decoration:none;font-weight:500}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--text)}.ds-nav a:focus-visible{outline:3px solid var(--focus);outline-offset:2px;}@media(max-width:640px){.ds-nav{gap:.25rem 1rem}.ds-nav a{padding:.4rem 0}}"
    },
    {
      "name": "Install block",
      "kind": "custom",
      "description": "Existing shell installation example.",
      "html": "<pre class=\"ds-code\"><code>dotnet add package Pineapple</code></pre>",
      "css": ".ds-code{background:var(--code-bg);color:var(--text);border:1px solid var(--border);border-radius:var(--radius);padding:1rem;overflow-x:auto;line-height:1.45;font-family:ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace;font-size:.9em}.ds-code code{font-family:ui-monospace, \"SF Mono\", \"Cascadia Code\", Menlo, Consolas, monospace;font-size:.9em}",
      "refersTo": "code-block"
    },
    {
      "name": "Callout",
      "kind": "card",
      "description": "Existing deprecation callout from the timeout guide.",
      "html": "<div class=\"ds-callout\"><strong>Deprecated in 2.0 (PINE003).</strong> Use <code>CancellationTokenSource(TimeSpan)</code>, <code>Task.WaitAsync</code>, or a Polly retry. <code>Parallelism</code> is not deprecated.</div>",
