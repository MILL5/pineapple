<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <PackageId>Pineapple</PackageId>
    <RootNamespace>Pineapple</RootNamespace>
    <AssemblyName>Pineapple</AssemblyName>
    <Title>Pineapple — Guava-inspired core utilities for .NET</Title>
    <Description>Pineapple is a Guava-inspired set of core utilities for .NET: guard clauses (preconditions), ShortGuid, deterministic xxHash-based HashCode, SQL Server RowVersion, rate limiting and resource governors, timing scopes, timeouts, exponential backoff, and safe cleanup helpers.</Description>
    <PackageTags>guava;guard;guard-clauses;preconditions;shortguid;hashcode;xxhash;rowversion;rate-limiting;throttling;resource-governor;backoff;timeout;utilities;dotnet</PackageTags>
    <PackageReleaseNotes>2.0.0: Targets .NET 8 and .NET 10. Drops netstandard2.0. Brotli handler now uses System.IO.Compression. Health checks use HttpClient. All dependencies upgraded. See https://github.com/MILL5/pineapple/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="K4os.Hash.xxHash" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Pineapple.Tests" />
  </ItemGroup>
</Project>
