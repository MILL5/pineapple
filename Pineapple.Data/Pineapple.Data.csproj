<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <PackageId>Pineapple.Data</PackageId>
    <Title>Pineapple.Data — SQL Server helpers for .NET</Title>
    <Description>Pineapple.Data adds SQL Server helpers to Pineapple: an Entity Framework Core model for INFORMATION_SCHEMA (tables, columns, key columns, constraints) and a SQL Server availability check for serverless and Azure SQL databases.</Description>
    <PackageTags>sqlserver;azure-sql;information-schema;entity-framework-core;efcore;serverless;sql;health-check</PackageTags>
    <PackageReleaseNotes>2.0.1: Documentation-only patch correcting the migration-guide link in the packaged README. No runtime behavior, public API, target framework, or external dependency changes. Original 2.0.0 packages remain intact. Migration guide: https://mill5.github.io/pineapple/guides/migration/</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Pineapple\Pineapple.csproj" />
  </ItemGroup>
</Project>
