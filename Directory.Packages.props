<Project>
  <ItemGroup>
    <!-- Pineapple -->
    <PackageVersion Include="K4os.Hash.xxHash" Version="1.0.8" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />

    <!-- Pineapple.Data -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />

    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />

    <!-- Tests -->
    <PackageVersion Include="MSTest" Version="4.5.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <!-- Use stable EF providers; net11 uses EF10 until EF11 is generally available. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.33" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.22" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == 'net11.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
  </ItemGroup>
</Project>
