<Project>
  <ItemGroup>
    <!-- Pineapple -->
    <PackageVersion Include="K4os.Hash.xxHash" Version="1.0.8" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />

    <!-- Pineapple.Data -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.1.1" />

    <!-- Tests -->
    <PackageVersion Include="MSTest" Version="4.5.1" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <!-- EF Core majors track the target framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.31" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
  </ItemGroup>
</Project>
